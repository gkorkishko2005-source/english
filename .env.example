# PolyGlotty environment template — copy to .env for local dev.
# In production these are set in Railway → Variables (NOT committed to git).

# ── Core ─────────────────────────────────────────────────────────────
BOT_TOKEN=
ANTHROPIC_API_KEY=
DATABASE_URL=

# ── Mandatory channel-subscription gate ──────────────────────────────
# Users must join this channel before the bot/Mini App unlocks. The bot
# MUST be an admin of the channel so getChatMember can read membership.
# REQUIRE_CHANNEL_SUB=0 disables the gate without a code change.
TG_CHANNEL_USERNAME=@polyglotty_daily
TG_CHANNEL_ID=-1003987215459
REQUIRE_CHANNEL_SUB=1

# ── Google Gemini (free tier for non-premium users) ──────────────────
# AI Studio key (https://aistudio.google.com/apikey). Standard keys start
# with "AIza...". Routing: premium → Anthropic, free → Gemini 1.5 Flash.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_FREE_ENABLED=1
# TEMP TEST: 1 = route EVERY user (incl. Premium) to Gemini, bypass Claude.
# Leave at 0 in normal operation; delete/0 to restore Claude for paying users.
GEMINI_FORCE_ALL=0
GEMINI_MAX_TOKENS=600
GEMINI_TIMEOUT=45
